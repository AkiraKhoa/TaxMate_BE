{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=taxmate_db;Username=postgres;Password=12345"
  },
  "Jwt": {
    "SecretKey": "CHANGE_THIS_TO_A_SECURE_KEY_AT_LEAST_32_CHARACTERS",
    "Issuer": "TaxMate.API",
    "Audience": "TaxMate.Client",
    "ExpirationInMinutes": 60
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedHosts": "*"
}
